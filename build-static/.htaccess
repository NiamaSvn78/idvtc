Options -MultiViews
RewriteEngine On
RewriteBase /

# Servir directement les fichiers et dossiers existants
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d

# Pages standalone — URL propre → fichier .html
RewriteRule ^a-propos/?$ /a-propos.html [L]
RewriteRule ^faq/?$ /faq.html [L]
RewriteRule ^chauffeur-prive-versailles/?$ /chauffeur-prive-versailles.html [L]
RewriteRule ^chauffeur-prive-neuilly-sur-seine/?$ /chauffeur-prive-neuilly-sur-seine.html [L]
RewriteRule ^chauffeur-prive-boulogne-billancourt/?$ /chauffeur-prive-boulogne-billancourt.html [L]
RewriteRule ^vtc-la-defense/?$ /vtc-la-defense.html [L]
RewriteRule ^vtc-vincennes/?$ /vtc-vincennes.html [L]
RewriteRule ^transfert-roissy-cdg/?$ /transfert-roissy-cdg.html [L]
RewriteRule ^transfert-orly-paris/?$ /transfert-orly-paris.html [L]
