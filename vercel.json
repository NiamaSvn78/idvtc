{
  "version": 2,
  "builds": [
    {
      "src": "index.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": ["vtc-project/public/**", "lib/**"]
      }
    },
    {
      "src": "vtc-project/public/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/index.js" },
    { "src": "/reservation/(.*)", "dest": "/index.js" },
    { "src": "/mission-order/(.*)", "dest": "/index.js" },

    { "handle": "filesystem" },

    {
      "src": "^/(a-propos|faq|cgv|mentions-legales|confidentialite|chauffeur-prive-versailles|chauffeur-prive-neuilly-sur-seine|chauffeur-prive-boulogne-billancourt|vtc-la-defense|vtc-vincennes|transfert-roissy-cdg|transfert-orly-paris|cdg-airport-transfer-paris|orly-airport-transfer-paris|annuler-reservation|admin|payment-success)$",
      "headers": {
        "Content-Security-Policy": "default-src 'self';script-src 'self' 'unsafe-inline';script-src-attr 'unsafe-inline';style-src 'self' 'unsafe-inline' https://fonts.googleapis.com;font-src 'self' https://fonts.gstatic.com;img-src 'self' data: https://images.unsplash.com;connect-src 'self' https://api-adresse.data.gouv.fr https://api.qrserver.com https://router.project-osrm.org;object-src 'none';base-uri 'self';frame-ancestors 'self';form-action 'self';upgrade-insecure-requests",
        "Cross-Origin-Opener-Policy": "same-origin",
        "Cross-Origin-Resource-Policy": "same-origin",
        "Origin-Agent-Cluster": "?1",
        "Referrer-Policy": "no-referrer",
        "Strict-Transport-Security": "max-age=31536000; includeSubDomains",
        "X-Content-Type-Options": "nosniff",
        "X-DNS-Prefetch-Control": "off",
        "X-Download-Options": "noopen",
        "X-Frame-Options": "SAMEORIGIN",
        "X-Permitted-Cross-Domain-Policies": "none",
        "X-XSS-Protection": "0",
        "Cache-Control": "public, max-age=0, must-revalidate"
      },
      "continue": true
    },
    {
      "src": "^/$",
      "headers": {
        "Content-Security-Policy": "default-src 'self';script-src 'self' 'unsafe-inline';script-src-attr 'unsafe-inline';style-src 'self' 'unsafe-inline' https://fonts.googleapis.com;font-src 'self' https://fonts.gstatic.com;img-src 'self' data: https://images.unsplash.com;connect-src 'self' https://api-adresse.data.gouv.fr https://api.qrserver.com https://router.project-osrm.org;object-src 'none';base-uri 'self';frame-ancestors 'self';form-action 'self';upgrade-insecure-requests",
        "Cross-Origin-Opener-Policy": "same-origin",
        "Cross-Origin-Resource-Policy": "same-origin",
        "Origin-Agent-Cluster": "?1",
        "Referrer-Policy": "no-referrer",
        "Strict-Transport-Security": "max-age=31536000; includeSubDomains",
        "X-Content-Type-Options": "nosniff",
        "X-DNS-Prefetch-Control": "off",
        "X-Download-Options": "noopen",
        "X-Frame-Options": "SAMEORIGIN",
        "X-Permitted-Cross-Domain-Policies": "none",
        "X-XSS-Protection": "0",
        "Cache-Control": "public, max-age=0, must-revalidate"
      },
      "continue": true
    },
    {
      "src": "^/css/(.*)$",
      "headers": {
        "Cache-Control": "public, max-age=86400",
        "X-Content-Type-Options": "nosniff"
      },
      "continue": true
    },
    {
      "src": "^/js/(.*)$",
      "headers": {
        "Cache-Control": "public, max-age=86400",
        "X-Content-Type-Options": "nosniff"
      },
      "continue": true
    },

    { "src": "/(.*)", "dest": "/vtc-project/public/$1", "check": true },

    { "src": "/", "dest": "/vtc-project/public/index.html" },
    { "src": "/a-propos", "dest": "/vtc-project/public/a-propos.html" },
    { "src": "/faq", "dest": "/vtc-project/public/faq.html" },
    { "src": "/cgv", "dest": "/vtc-project/public/cgv.html" },
    { "src": "/mentions-legales", "dest": "/vtc-project/public/mentions-legales.html" },
    { "src": "/confidentialite", "dest": "/vtc-project/public/confidentialite.html" },
    { "src": "/chauffeur-prive-versailles", "dest": "/vtc-project/public/chauffeur-prive-versailles.html" },
    { "src": "/chauffeur-prive-neuilly-sur-seine", "dest": "/vtc-project/public/chauffeur-prive-neuilly-sur-seine.html" },
    { "src": "/chauffeur-prive-boulogne-billancourt", "dest": "/vtc-project/public/chauffeur-prive-boulogne-billancourt.html" },
    { "src": "/vtc-la-defense", "dest": "/vtc-project/public/vtc-la-defense.html" },
    { "src": "/vtc-vincennes", "dest": "/vtc-project/public/vtc-vincennes.html" },
    { "src": "/transfert-roissy-cdg", "dest": "/vtc-project/public/transfert-roissy-cdg.html" },
    { "src": "/transfert-orly-paris", "dest": "/vtc-project/public/transfert-orly-paris.html" },
    { "src": "/cdg-airport-transfer-paris", "dest": "/vtc-project/public/cdg-airport-transfer-paris.html" },
    { "src": "/orly-airport-transfer-paris", "dest": "/vtc-project/public/orly-airport-transfer-paris.html" },
    { "src": "/annuler-reservation", "dest": "/vtc-project/public/annuler-reservation.html" },
    { "src": "/admin", "dest": "/vtc-project/public/admin.html" },
    { "src": "/payment-success", "dest": "/vtc-project/public/payment-success.html" },

    { "src": "/(.*)", "dest": "/index.js" }
  ]
}
