{
  "version": 2,
  "builds": [
    {
      "src": "index.js",
      "use": "@vercel/node"
    },
    {
      "src": "vtc-project/public/**/*",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/vtc-project/public/(.*)",
      "dest": "vtc-project/public/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/index.js"
    }
  ]
}